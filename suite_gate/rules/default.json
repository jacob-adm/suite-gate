{
  "format": "gate-rules/1",
  "name": "default",
  "version": 1,
  "checks": [
    {"tool": "git-surface"},
    {"tool": "trust-path", "when_changed": ["^\\.github/workflows/"]},
    {"tool": "release-drift",
     "for_each_changed": ["(^|/)(package-lock\\.json|npm-shrinkwrap\\.json|uv\\.lock|poetry\\.lock|requirements[^/]*\\.txt)$"]},
    {"tool": "git-overlap", "others": "refs/heads/"}
  ],
  "verdict": {"fail": ["high"], "warn": ["medium", "low"]}
}
