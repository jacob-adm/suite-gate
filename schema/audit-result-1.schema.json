{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-result-1.schema.json",
  "title": "Audit result, format 1",
  "description": "One run of one audit tool. The rules linking exit, findings and errors are in docs/format.md and are checked by suite_gate.envelope.validate, not by this schema.",
  "type": "object",
  "required": ["format", "tool", "target", "exit", "findings", "errors"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "audit-result/1"},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "required": ["kind", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["repository", "artifact", "package", "host"]},
        "name": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "base": {"type": "string", "minLength": 1}
      }
    },
    "exit": {"enum": [0, 1, 2]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["rule", "severity", "message", "evidence", "record"],
      "additionalProperties": false,
      "properties": {
        "rule": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "severity": {"enum": ["high", "medium", "low", "info"]},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"},
        "record": {"type": "object"}
      }
    },
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "commit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
        "ref": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"}
      },
      "dependentRequired": {"line": ["path"]}
    },
    "error": {
      "type": "object",
      "required": ["message"],
      "additionalProperties": false,
      "properties": {
        "message": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    }
  }
}
