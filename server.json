{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jacob-adm/suite-gate",
  "title": "suite-gate",
  "description": "Lets a coding agent run the installed PR audit tools and read their findings in one format.",
  "repository": {
    "url": "https://github.com/jacob-adm/suite-gate",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "suite-gate",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
